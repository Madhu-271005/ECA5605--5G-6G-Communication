clear;
clc;
close all;

% Study area
studyAreaKm2 = 4.0;

% Different cell radii
cellRadiiKm = [1.00, 0.75, 0.50];

% Area of a regular hexagonal cell
cellAreaKm2 = (3 * sqrt(3) / 2) .* cellRadiiKm.^2;

% Estimate number of cells required
% ceil() rounds the value upward
estimatedCells = ceil(studyAreaKm2 ./ cellAreaKm2);

% Create results table
results = table( ...
    cellRadiiKm', ...
    cellAreaKm2', ...
    estimatedCells', ...
    'VariableNames', ...
    {'CellRadius_km', 'CellArea_km2', 'EstimatedNumberOfCells'});

% Display results
disp('Estimated cells required:');
disp(results);

% Plot
figure;

bar(cellRadiiKm, estimatedCells, 0.6);

xlabel('Cell radius (km)');
ylabel('Estimated number of cells');

title('Cell Radius versus Estimated Number of Cells');

grid on;

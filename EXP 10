clc;
clear;
close all;

%% 1. Input Parameters Setup

N_bits = 50000;          % Data length per SNR point
SNR_dB = 0:2:20;         % SNR operating range

alpha1 = 0.75;            % Far user (User 1) power allocation coefficient
alpha2 = 1 - alpha1;      % Near user (User 2) power allocation coefficient

% BER result arrays
ber_User1 = zeros(length(SNR_dB), 1);
ber_User2 = zeros(length(SNR_dB), 1);
ber_OFDMA = zeros(length(SNR_dB), 1);

%% 2. Data Processing Execution Loop

for s = 1:length(SNR_dB)

    % Convert SNR from dB to linear scale
    snr_linear = 10^(SNR_dB(s) / 10);

    % Noise variance
    noise_variance = 1 / snr_linear;

    % Generate source bits
    bits_u1 = randi([0 1], N_bits, 1);
    bits_u2 = randi([0 1], N_bits, 1);

    % BPSK constellation mapping
    x1 = 2 * bits_u1 - 1;
    x2 = 2 * bits_u2 - 1;

    % Power-Domain NOMA superposition
    x_noma = sqrt(alpha1) * x1 + ...
             sqrt(alpha2) * x2;

    % AWGN noise
    noise = sqrt(noise_variance / 2) * ...
        (randn(N_bits, 1) + 1i * randn(N_bits, 1));

    % Received NOMA signal
    y_noma = real(x_noma + noise);

    %% 3. User 1 Direct Detection

    dec_u1 = y_noma > 0;

    est_x1 = 2 * dec_u1 - 1;

    % BER for User 1
    ber_User1(s) = ...
        sum(bits_u1 ~= dec_u1) / N_bits;

    %% 4. Successive Interference Cancellation (SIC)

    % Subtract reconstructed User 1 signal
    y_sic = y_noma - sqrt(alpha1) * est_x1;

    % Detect User 2
    dec_u2 = y_sic > 0;

    % BER for User 2
    ber_User2(s) = ...
        sum(bits_u2 ~= dec_u2) / N_bits;

    %% 5. OFDMA Baseline

    % Orthogonal transmission for User 1
    y_ofdma = x1 + ...
        sqrt(noise_variance * 2) / sqrt(2) * randn(N_bits, 1);

    % BPSK detection
    dec_ofdma = y_ofdma > 0;

    % BER for OFDMA
    ber_OFDMA(s) = ...
        sum(bits_u1 ~= dec_ofdma) / N_bits;

end

%% 6. BER Performance Graph

figure('Name', 'NOMA SIC Evaluation Matrix');

semilogy(SNR_dB, ber_User1, ...
    'ro-', 'LineWidth', 1.2);

hold on;

semilogy(SNR_dB, ber_User2, ...
    'bs-', 'LineWidth', 1.2);

semilogy(SNR_dB, ber_OFDMA, ...
    'k--', 'LineWidth', 1.2);

grid on;

xlabel('Channel SNR Scaling Index (dB)');
ylabel('Bit Error Rate (BER)');

title('NOMA Power-Domain Transceiver Performance Chart');

legend( ...
    'User 1 (Far Node Direct Dec)', ...
    'User 2 (Near Node Post-SIC Dec)', ...
    'Baseline OFDMA Orthogonal Benchmark', ...
    'Location', 'best');

hold off;
